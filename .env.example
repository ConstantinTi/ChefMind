# ── Datenablage ───────────────────────────────────────────────────────────────
# SQLite-Datei und Foto-Uploads. Im Container liegt beides unter /data (Volume).
CHEFMIND_DB_PATH=./data/chefmind.db
CHEFMIND_UPLOAD_DIR=./data/uploads

# ── KI-Import (Foto- und URL-Import) ──────────────────────────────────────────
# "anthropic" | "openrouter" | "none"  ("none" deaktiviert den KI-Import;
# der URL-Import über schema.org JSON-LD funktioniert auch dann noch.)
CHEFMIND_AI_PROVIDER=anthropic

# Anthropic (Standard). Modell optional — Default ist claude-opus-5.
ANTHROPIC_API_KEY=
# CHEFMIND_AI_MODEL=claude-opus-5

# OpenRouter — freie Modellwahl. Bei CHEFMIND_AI_PROVIDER=openrouter ist
# CHEFMIND_AI_MODEL Pflicht, z. B. anthropic/claude-sonnet-5 oder google/gemini-3-pro.
OPENROUTER_API_KEY=
# CHEFMIND_AI_MODEL=anthropic/claude-sonnet-5

# ── Netzzugriff ───────────────────────────────────────────────────────────────
# Ohne Konfiguration antwortet ChefMind nur Clients mit privater Adresse:
# LAN (10.x, 172.16–31.x, 192.168.x), Loopback, Link-local, Tailscale
# (100.64–127.x und fd7a::/48) sowie IPv6 ULA (fc00::/7). Nichts einzutragen.
#
# Diese Prüfung liest x-forwarded-for. Next füllt den Header aus der Verbindung,
# ein Client kann ihn aber auch selbst setzen — sie ist also ein Schutz gegen
# versehentliche Freigabe und Scanner, keine Grenze gegen jemanden, der den Port
# ohnehin erreicht. Die echte Grenze ist das Port-Binding in docker-compose.yml.
#
# 1 = Prüfung abschalten. Nur sinnvoll hinter einem Reverse Proxy, der selbst
# authentifiziert — die App hat kein Login.
CHEFMIND_ALLOW_PUBLIC_ACCESS=0

# Zusätzlich erlaubte Host-Namen, kommagetrennt, OHNE Port.
# Nur nötig für eine echte Domain: von der kann der Server nicht unterscheiden,
# ob sie dir gehört oder einem Angreifer, der sie auf diese Adresse auflöst
# (DNS-Rebinding). Ohne Eintrag gelten bereits: private IP-Adressen, localhost,
# Hostnamen ohne Punkt sowie .local, .lan, .internal, .home.arpa und .ts.net.
# CHEFMIND_ALLOWED_HOSTS=kueche.meinedomain.de

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Zusätzliche Namen/Adressen im selbst signierten Zertifikat, kommagetrennt.
# Loopback, der Hostname und alle privaten Adressen dieses Rechners sind ohnehin
# enthalten — erzeugt von scripts/generate-cert.sh (make cert).
# Über Tailscale wird das nicht gebraucht: `make tls-tailscale` besorgt ein
# echtes, öffentlich vertrautes Zertifikat für den .ts.net-Namen.
# CHEFMIND_TLS_HOSTS=kueche.fritz.box,192.168.1.250

# ── Portionen ─────────────────────────────────────────────────────────────────
# Für wie viele Personen normalerweise gekocht wird. Rezepte öffnen sich mit
# dieser Zahl statt mit ihrer eigenen; die Originalangabe bleibt daneben sichtbar.
# Rezepte, die nicht in Portionen rechnen (Scheiben, Stück), bleiben unberührt.
CHEFMIND_DEFAULT_SERVINGS=4

# ── MCP-Server (/mcp) ─────────────────────────────────────────────────────────
# 1 = nur lesende MCP-Tools registrieren (kein Anlegen/Ändern/Löschen).
CHEFMIND_MCP_READONLY=0

# Optional: statisches Bearer-Token für /mcp. Leer = kein Auth (nur im LAN/VPN!).
CHEFMIND_MCP_TOKEN=
