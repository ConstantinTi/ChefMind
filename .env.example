# ── Datenablage ───────────────────────────────────────────────────────────────
# SQLite-Datei und Foto-Uploads. Im Container liegt beides unter /data (Volume).
CHEFMIND_DB_PATH=./data/chefmind.db
CHEFMIND_UPLOAD_DIR=./data/uploads

# ── KI-Import (Foto- und URL-Import) ──────────────────────────────────────────
# "anthropic" | "openrouter" | "none"  ("none" deaktiviert den KI-Import;
# der URL-Import über schema.org JSON-LD funktioniert auch dann noch.)
CHEFMIND_AI_PROVIDER=anthropic

# Anthropic (Standard). Modell optional — Default ist claude-opus-5.
ANTHROPIC_API_KEY=
# CHEFMIND_AI_MODEL=claude-opus-5

# OpenRouter — freie Modellwahl. Bei CHEFMIND_AI_PROVIDER=openrouter ist
# CHEFMIND_AI_MODEL Pflicht, z. B. anthropic/claude-sonnet-5 oder google/gemini-3-pro.
OPENROUTER_API_KEY=
# CHEFMIND_AI_MODEL=anthropic/claude-sonnet-5

# ── MCP-Server (/mcp) ─────────────────────────────────────────────────────────
# Kommagetrennte Hostnamen, unter denen die App erreichbar ist — OHNE Port.
# Schützt gegen DNS-Rebinding: sonst kann eine fremde Webseite, die du besuchst,
# ihren eigenen Namen auf diesen Server auflösen und deine Rezepte löschen.
# Für den Zugriff aus dem LAN hier den Hostnamen oder die IP des Servers ergänzen.
CHEFMIND_ALLOWED_HOSTS=localhost,127.0.0.1,chefmind.local
CHEFMIND_ALLOWED_ORIGINS=localhost,127.0.0.1,chefmind.local

# 1 = nur lesende MCP-Tools registrieren (kein Anlegen/Ändern/Löschen).
CHEFMIND_MCP_READONLY=0

# Optional: statisches Bearer-Token für /mcp. Leer = kein Auth (nur im LAN/VPN!).
CHEFMIND_MCP_TOKEN=
