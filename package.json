{
  "name": "chefmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private Rezeptverwaltung mit Portionsrechner, Wochenplan und MCP-Server",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrate.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
